									"    pm.expect(responseData.distance).to.exist;",
									"    pm.expect(responseData.freq_min).to.exist;",
									"    pm.expect(responseData.freq_max).to.exist;",
									"    pm.expect(responseData.data).to.exist;",
									"});",
									"",
